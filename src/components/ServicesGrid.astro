---
import { getLocaleFromUrl, getDict } from '@i18n/utils';

interface Props {
  showHeader?: boolean;
}

const { showHeader = true } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const dict = getDict(locale);

const icons = [
  // SaaS Platforms — cloud
  'M17.5 19a4.5 4.5 0 1 0-1.5-8.75 6 6 0 0 0-11.5 2.25A4.5 4.5 0 0 0 6.5 19h11z',
  // Business Systems — briefcase
  'M20 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zM16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16',
  // Customer Apps — smartphone
  'M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2',
  // AI Products — sparkle
  'M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2z',
  // Smart Factory — factory
  'M2 21h20M4 21V10l4 2V10l4 2V10l4 2V10l4 2v9M8 21v-4M12 21v-4M16 21v-4',
  // System Integration — link
  'M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71',
];
---

<section id="services" class="relative scroll-mt-24">
  <div class={`container-x ${showHeader ? 'py-24 sm:py-28' : 'pt-6 pb-24 sm:pb-28'}`}>
    {
      showHeader && (
        <div class="mb-14 max-w-2xl">
          <p class="eyebrow mb-4">{dict.services.eyebrow}</p>
          <h2 class="heading-section text-balance">{dict.services.title}</h2>
          {dict.services.subtitle && (
            <p class="mt-4 text-body text-balance">{dict.services.subtitle}</p>
          )}
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        dict.services.items.map((item, i) => (
          <article class="surface-card surface-card-hover group p-6">
            <div class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-lg border border-hairline bg-charcoal/60 text-moa-cyan transition group-hover:border-moa-blue/40 group-hover:text-white">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[i] ?? icons[0]} />
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-white">{item.title}</h3>
            <p class="text-sm leading-relaxed text-muted">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
