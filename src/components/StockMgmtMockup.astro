---
// Stylized infographic mockup for the Stock Management System featured card.
// Combines a real-looking app window (left, foreground) with an isometric
// warehouse shelf + boxes (right, background) — communicates both "this is the
// product UI" and "this manages physical inventory" without leaking any client
// branding. All data synthetic.

const C = 0.8660; // cos 30
const S = 0.5; // sin 30

const w2s = (x: number, y: number, z = 0, ox = 0, oy = 0) => ({
  sx: ox + C * x - C * y,
  sy: oy - S * x - S * y - z,
});

const boxCorners = (
  wx: number,
  wy: number,
  bw: number,
  bd: number,
  bh: number,
  ox: number,
  oy: number,
) => {
  const local: Record<string, [number, number, number]> = {
    F: [0, 0, 0],
    R: [bw, 0, 0],
    B: [bw, bd, 0],
    L: [0, bd, 0],
    Ft: [0, 0, bh],
    Rt: [bw, 0, bh],
    Bt: [bw, bd, bh],
    Lt: [0, bd, bh],
  };
  const out: Record<string, { sx: number; sy: number }> = {};
  for (const [k, [lx, ly, lz]] of Object.entries(local)) {
    out[k] = w2s(wx + lx, wy + ly, lz, ox, oy);
  }
  return out;
};

const OX = 180; // platform world-origin X in SVG coords
const OY = 380; // platform world-origin Y in SVG coords
const PW = 320; // platform world width
const PD = 200; // platform world depth
const BW = 70; // box width
const BD = 70; // box depth
const BH = 44; // box height (slightly squat)

const platform = {
  F: w2s(0, 0, 0, OX, OY),
  R: w2s(PW, 0, 0, OX, OY),
  B: w2s(PW, PD, 0, OX, OY),
  L: w2s(0, PD, 0, OX, OY),
};

// Painter's order: back row (high world-y) first, then front row
const boxData = [
  { x: 50, y: 110, kind: 'normal' as const },
  { x: 120, y: 110, kind: 'normal' as const },
  { x: 190, y: 110, kind: 'accent' as const },
  { x: 50, y: 30, kind: 'normal' as const },
  { x: 120, y: 30, kind: 'alert' as const },
  { x: 190, y: 30, kind: 'normal' as const },
];

const boxes = boxData.map((b) => ({
  ...b,
  c: boxCorners(b.x, b.y, BW, BD, BH, OX, OY),
}));

const pts = (...arr: { sx: number; sy: number }[]) =>
  arr.map((p) => `${p.sx.toFixed(1)},${p.sy.toFixed(1)}`).join(' ');

const rows = [
  { sku: 'SKU-3421', name: 'Component A1', cat: 'Mechanical', qty: 12, status: 'ok' },
  { sku: 'SKU-1198', name: 'Module ZX', cat: 'Electronic', qty: 5, status: 'low' },
  { sku: 'SKU-7720', name: 'Connector set', cat: 'Electronic', qty: 45, status: 'ok' },
  { sku: 'SKU-4055', name: 'Drive belt', cat: 'Mechanical', qty: 23, status: 'ok' },
  { sku: 'SKU-9810', name: 'Controller M', cat: 'Assembly', qty: 8, status: 'warn' },
] as const;

const statusChip: Record<'ok' | 'low' | 'warn', string> = {
  ok: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
  low: 'bg-red-500/20 text-red-300 border-red-500/40',
  warn: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
};
---

<div class="relative mx-auto w-full max-w-xl" style="aspect-ratio: 1216 / 1096">
  {/* ── Warehouse: isometric shelf + boxes (background) ────────────────── */}
  <div class="absolute right-[-2%] top-[37%] w-[52%]">
    <svg viewBox="0 0 500 420" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <defs>
        <linearGradient id="boxTop" x1="0" y1="0" x2="0.5" y2="1">
          <stop offset="0%" stop-color="#64748b" />
          <stop offset="100%" stop-color="#475569" />
        </linearGradient>
        <linearGradient id="boxTopAccent" x1="0" y1="0" x2="0.5" y2="1">
          <stop offset="0%" stop-color="#3a8a99" />
          <stop offset="100%" stop-color="#155e75" />
        </linearGradient>
        <linearGradient id="platTop" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#475569" />
          <stop offset="100%" stop-color="#1e293b" />
        </linearGradient>
        <radialGradient id="ambient" cx="50%" cy="55%" r="55%">
          <stop offset="0%" stop-color="#5E6AD2" stop-opacity="0.25" />
          <stop offset="60%" stop-color="#5E6AD2" stop-opacity="0.05" />
          <stop offset="100%" stop-color="#5E6AD2" stop-opacity="0" />
        </radialGradient>
        <filter id="boxShadow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="4" />
          <feOffset dy="3" />
          <feComponentTransfer><feFuncA type="linear" slope="0.4" /></feComponentTransfer>
          <feMerge>
            <feMergeNode />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      {/* Ambient glow */}
      <ellipse cx="260" cy="280" rx="240" ry="160" fill="url(#ambient)" />

      {/* Platform (shelf top surface) */}
      <polygon
        points={pts(platform.F, platform.R, platform.B, platform.L)}
        fill="url(#platTop)"
        stroke="#64748b"
        stroke-width="0.6"
        stroke-opacity="0.5"
      />

      {/* Platform top-edge subtle highlight */}
      <line
        x1={platform.L.sx} y1={platform.L.sy}
        x2={platform.B.sx} y2={platform.B.sy}
        stroke="#94a3b8" stroke-width="0.6" stroke-opacity="0.4"
      />
      <line
        x1={platform.B.sx} y1={platform.B.sy}
        x2={platform.R.sx} y2={platform.R.sy}
        stroke="#94a3b8" stroke-width="0.6" stroke-opacity="0.4"
      />

      {/* Shelf support: thin vertical posts at front-left and front-right corners */}
      <line x1={platform.F.sx} y1={platform.F.sy} x2={platform.F.sx} y2={platform.F.sy + 28} stroke="#475569" stroke-width="2" stroke-opacity="0.6" />
      <line x1={platform.L.sx} y1={platform.L.sy} x2={platform.L.sx} y2={platform.L.sy + 36} stroke="#475569" stroke-width="2" stroke-opacity="0.5" />
      <line x1={platform.R.sx} y1={platform.R.sy} x2={platform.R.sx} y2={platform.R.sy + 36} stroke="#475569" stroke-width="2" stroke-opacity="0.5" />

      {/* Boxes (painter's order: back row first, then front row) */}
      {boxes.map((b) => {
        const isAccent = b.kind === 'accent';
        const rightFill = isAccent ? '#155e75' : '#334155';
        const leftFill = isAccent ? '#0e4452' : '#1e293b';
        const topFill = isAccent ? 'url(#boxTopAccent)' : 'url(#boxTop)';
        return (
          <g>
            {/* Right face */}
            <polygon
              points={pts(b.c.F, b.c.R, b.c.Rt, b.c.Ft)}
              fill={rightFill}
              stroke="#0f172a"
              stroke-width="0.5"
            />
            {/* Left face */}
            <polygon
              points={pts(b.c.F, b.c.L, b.c.Lt, b.c.Ft)}
              fill={leftFill}
              stroke="#0f172a"
              stroke-width="0.5"
            />
            {/* Top face */}
            <polygon
              points={pts(b.c.Ft, b.c.Rt, b.c.Bt, b.c.Lt)}
              fill={topFill}
              stroke="#475569"
              stroke-width="0.5"
            />

            {/* Top-edge highlight on the two front-facing top edges */}
            <line x1={b.c.Ft.sx} y1={b.c.Ft.sy} x2={b.c.Rt.sx} y2={b.c.Rt.sy} stroke="#94a3b8" stroke-width="0.5" stroke-opacity="0.5" />
            <line x1={b.c.Ft.sx} y1={b.c.Ft.sy} x2={b.c.Lt.sx} y2={b.c.Lt.sy} stroke="#94a3b8" stroke-width="0.5" stroke-opacity="0.4" />

            {/* Brand label sticker on right face */}
            <rect
              x={b.c.F.sx + 5}
              y={(b.c.F.sy + b.c.Ft.sy) / 2 - 4}
              width="18"
              height="3.5"
              fill={isAccent ? '#26C6DA' : '#475569'}
              opacity="0.85"
              rx="0.5"
            />
            <rect
              x={b.c.F.sx + 5}
              y={(b.c.F.sy + b.c.Ft.sy) / 2 + 2}
              width="14"
              height="2"
              fill="#1e293b"
              opacity="0.7"
              rx="0.5"
            />
          </g>
        );
      })}

      {/* Alert overlay (drawn last so neighbouring boxes don't clip the amber outline) */}
      {boxes.filter((b) => b.kind === 'alert').map((b) => (
        <g>
          {/* Tint all three visible faces */}
          <polygon points={pts(b.c.Ft, b.c.Rt, b.c.Bt, b.c.Lt)} fill="#f59e0b" fill-opacity="0.12" stroke="#f59e0b" stroke-width="1.4" stroke-linejoin="round" />
          <polygon points={pts(b.c.F, b.c.R, b.c.Rt, b.c.Ft)} fill="#f59e0b" fill-opacity="0.08" stroke="#f59e0b" stroke-width="1.4" stroke-linejoin="round" />
          <polygon points={pts(b.c.F, b.c.L, b.c.Lt, b.c.Ft)} fill="#f59e0b" fill-opacity="0.08" stroke="#f59e0b" stroke-width="1.4" stroke-linejoin="round" />
          {/* ! badge */}
          <circle cx={b.c.Ft.sx} cy={b.c.Ft.sy - 14} r="7.5" fill="#f59e0b" stroke="#0F172A" stroke-width="1" />
          <text
            x={b.c.Ft.sx}
            y={b.c.Ft.sy - 11}
            text-anchor="middle"
            font-size="10"
            font-weight="700"
            fill="#0F172A"
            font-family="Kanit, sans-serif"
          >!</text>
        </g>
      ))}
    </svg>
  </div>

  {/* ── App window (foreground) ─────────────────────────────────────────── */}
  <div
    class="absolute left-[1%] top-[15%] w-[66%] overflow-hidden rounded-xl border border-white/10 bg-slate-900"
  >
    {/* Title bar */}
    <div class="flex items-center justify-between border-b border-white/5 bg-slate-950/70 px-3 py-2">
      <div class="flex items-center gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-yellow-500"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-green-500"></span>
        <span class="ml-3 text-[10px] font-medium text-slate-400">Stock Management</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="rounded-full border border-white/10 px-2 py-0.5 text-[8px] font-medium text-slate-400">EN</span>
        <span class="h-4 w-4 rounded-full bg-gradient-to-br from-moa-blue to-moa-cyan"></span>
      </div>
    </div>

    <div class="flex">
      {/* Sidebar */}
      <div class="flex w-9 flex-col items-center gap-3 border-r border-white/5 bg-slate-950/40 py-3">
        {/* Active: parts (cube) */}
        <span class="relative flex h-6 w-6 items-center justify-center rounded-md bg-moa-blue/20 text-moa-cyan">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <span class="absolute -left-3 top-1 h-4 w-0.5 rounded-r bg-moa-cyan"></span>
        </span>
        {/* Invoices (document) */}
        <span class="flex h-6 w-6 items-center justify-center rounded-md text-slate-500 hover:text-slate-300">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </span>
        {/* Suppliers (truck) */}
        <span class="flex h-6 w-6 items-center justify-center rounded-md text-slate-500">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </span>
        {/* Clients (users) */}
        <span class="flex h-6 w-6 items-center justify-center rounded-md text-slate-500">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        {/* Team (user) */}
        <span class="flex h-6 w-6 items-center justify-center rounded-md text-slate-500">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
      </div>

      {/* Main */}
      <div class="flex-1 px-3 py-3">
        {/* Header row: title + search + new */}
        <div class="mb-2.5 flex items-center justify-between gap-2">
          <p class="text-[12px] font-semibold text-white">Inventory</p>
          <div class="flex items-center gap-1.5">
            <div class="flex items-center gap-1 rounded-md border border-white/10 bg-slate-800/60 px-1.5 py-0.5">
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <span class="text-[8px] text-slate-400">Search SKU…</span>
            </div>
            <span class="rounded-md bg-moa-blue/20 px-1.5 py-0.5 text-[8px] font-medium text-moa-cyan">+ New</span>
          </div>
        </div>

        {/* KPI strip */}
        <div class="mb-2.5 grid grid-cols-3 gap-1.5">
          <div class="rounded-md border border-white/5 bg-slate-800/40 p-1.5">
            <p class="text-[8px] text-slate-400">Total items</p>
            <p class="text-[13px] font-bold text-white">1,247</p>
          </div>
          <div class="rounded-md border border-white/5 bg-slate-800/40 p-1.5">
            <p class="text-[8px] text-slate-400">In stock</p>
            <p class="text-[13px] font-bold text-white">1,189</p>
          </div>
          <div class="rounded-md border border-amber-500/20 bg-amber-500/5 p-1.5">
            <p class="text-[8px] text-amber-400/70">Low stock</p>
            <p class="text-[13px] font-bold text-amber-300">23</p>
          </div>
        </div>

        {/* Table */}
        <div class="overflow-hidden rounded-md border border-white/5">
          <div class="grid grid-cols-[55px_1fr_55px_30px_50px] gap-1.5 bg-slate-800/60 px-2 py-1 text-[8px] font-semibold uppercase tracking-wider text-slate-400">
            <span>SKU</span>
            <span>Item</span>
            <span>Category</span>
            <span class="text-right">Qty</span>
            <span class="text-right">Status</span>
          </div>
          {rows.map((r) => (
            <div class={`grid grid-cols-[55px_1fr_55px_30px_50px] items-center gap-1.5 border-t border-white/5 px-2 py-1 text-[9px] ${r.status === 'low' ? 'bg-red-500/5' : ''}`}>
              <span class="font-mono text-slate-400">{r.sku}</span>
              <span class="truncate text-white">{r.name}</span>
              <span class="text-slate-400">{r.cat}</span>
              <span class={`text-right font-semibold ${r.status === 'low' ? 'text-red-300' : r.status === 'warn' ? 'text-amber-300' : 'text-slate-200'}`}>{r.qty}</span>
              <span class={`inline-flex justify-center rounded-full border px-1 py-px text-[7px] font-medium uppercase tracking-wider ${statusChip[r.status]}`}>
                {r.status === 'ok' ? 'In' : r.status === 'low' ? 'Low' : 'Warn'}
              </span>
            </div>
          ))}
        </div>

        {/* Pagination strip */}
        <div class="mt-2 flex items-center justify-between text-[8px] text-slate-500">
          <span>Showing 5 of 1,247</span>
          <span class="flex items-center gap-1">
            <span class="rounded border border-white/10 px-1 py-px">‹</span>
            <span class="rounded border border-moa-blue/30 bg-moa-blue/10 px-1 py-px text-slate-300">1</span>
            <span class="px-1">2</span>
            <span class="px-1">3</span>
            <span class="rounded border border-white/10 px-1 py-px">›</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  {/* ── Floating low-stock toast (bridges app and warehouse) ────────────── */}
  <div
    class="absolute right-[6%] top-[69%] flex w-[44%] items-center gap-2 rounded-lg border border-amber-500/30 bg-slate-900/95 p-2.5 backdrop-blur"
  >
    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-amber-500/15 text-amber-400">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </span>
    <div class="min-w-0 flex-1">
      <p class="text-[10px] font-semibold text-white">Low stock alert</p>
      <p class="truncate text-[9px] text-slate-400">Module ZX (SKU-1198) — 5 left</p>
    </div>
    <span class="rounded-full bg-amber-500/20 px-1.5 py-0.5 text-[8px] font-semibold text-amber-300">View</span>
  </div>
</div>
