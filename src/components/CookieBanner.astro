---
import { getLocaleFromUrl, getDict, localizePath } from '@i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const dict = getDict(locale);
const privacyHref = localizePath('/privacy', locale);
---

{/* Banner — hidden by default; shown via JS if no consent stored */}
<div
  id="cookie-banner"
  class="fixed bottom-4 left-1/2 z-50 hidden w-[calc(100%-2rem)] max-w-3xl -translate-x-1/2 rounded-2xl border border-hairline bg-surface/95 p-5 shadow-2xl backdrop-blur sm:left-4 sm:translate-x-0"
  role="dialog"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-body"
  data-cookie-banner
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
    <div class="flex-1">
      <p id="cookie-banner-title" class="mb-1 text-sm font-semibold text-white">{dict.cookies.title}</p>
      <p id="cookie-banner-body" class="text-xs leading-relaxed text-muted">
        {dict.cookies.body}{' '}
        <a href={privacyHref} class="text-moa-cyan hover:underline">{dict.cookies.privacyLink}</a>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" data-cookie-reject class="rounded-md border border-hairline px-3 py-1.5 text-xs font-medium text-white/80 hover:border-white/20 hover:text-white">
        {dict.cookies.reject}
      </button>
      <button type="button" data-cookie-settings class="rounded-md border border-hairline px-3 py-1.5 text-xs font-medium text-white/80 hover:border-white/20 hover:text-white">
        {dict.cookies.settings}
      </button>
      <button type="button" data-cookie-accept class="rounded-md bg-moa-gradient px-3 py-1.5 text-xs font-semibold text-white shadow-[0_0_0_1px_rgba(255,255,255,0.08)_inset]">
        {dict.cookies.accept}
      </button>
    </div>
  </div>
</div>

{/* Settings modal */}
<div
  id="cookie-settings-modal"
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-settings-title"
  data-cookie-modal
>
  <div class="w-full max-w-md rounded-2xl border border-hairline bg-charcoal p-6">
    <h2 id="cookie-settings-title" class="mb-2 text-lg font-semibold text-white">{dict.cookies.settingsTitle}</h2>
    <p class="mb-5 text-sm text-muted">{dict.cookies.settingsBody}</p>

    <div class="space-y-3">
      <label class="flex items-start justify-between gap-3 rounded-lg border border-hairline bg-surface/60 p-4">
        <div class="flex-1">
          <p class="text-sm font-semibold text-white">{dict.cookies.categoryEssentialTitle}</p>
          <p class="mt-1 text-xs text-muted">{dict.cookies.categoryEssentialDesc}</p>
        </div>
        <input type="checkbox" checked disabled class="mt-1 h-4 w-4 cursor-not-allowed accent-moa-blue opacity-60" />
      </label>

      <label class="flex items-start justify-between gap-3 rounded-lg border border-hairline bg-surface/60 p-4">
        <div class="flex-1">
          <p class="text-sm font-semibold text-white">{dict.cookies.categoryFunctionalTitle}</p>
          <p class="mt-1 text-xs text-muted">{dict.cookies.categoryFunctionalDesc}</p>
        </div>
        <input type="checkbox" data-cookie-functional class="mt-1 h-4 w-4 cursor-pointer accent-moa-blue" />
      </label>
    </div>

    <div class="mt-6 flex items-center justify-end gap-2">
      <button type="button" data-cookie-modal-close class="rounded-md border border-hairline px-4 py-2 text-sm text-white/80 hover:text-white">
        Cancel
      </button>
      <button type="button" data-cookie-save class="rounded-md bg-moa-gradient px-4 py-2 text-sm font-semibold text-white">
        {dict.cookies.save}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const KEY = 'moa-cookie-consent-v1';
    const banner = document.querySelector('[data-cookie-banner]');
    const modal = document.querySelector('[data-cookie-modal]');
    const functionalToggle = document.querySelector('[data-cookie-functional]');

    function readConsent() {
      try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
    }
    function writeConsent(state) {
      try { localStorage.setItem(KEY, JSON.stringify({ ...state, ts: Date.now() })); } catch {}
    }
    function showBanner() { banner?.classList.remove('hidden'); }
    function hideBanner() { banner?.classList.add('hidden'); }
    function openModal() {
      const current = readConsent();
      if (functionalToggle) functionalToggle.checked = current ? !!current.functional : true;
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }
    function closeModal() {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    // Show banner only when no consent recorded yet
    if (!readConsent()) showBanner();

    document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      writeConsent({ essential: true, functional: true });
      hideBanner();
    });
    document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
      writeConsent({ essential: true, functional: false });
      hideBanner();
    });
    document.querySelector('[data-cookie-settings]')?.addEventListener('click', openModal);
    document.querySelector('[data-cookie-modal-close]')?.addEventListener('click', closeModal);
    document.querySelector('[data-cookie-save]')?.addEventListener('click', () => {
      writeConsent({ essential: true, functional: !!functionalToggle?.checked });
      closeModal();
      hideBanner();
    });

    // Expose a way to re-open from a footer link
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target && target.closest && target.closest('[data-open-cookie-settings]')) {
        e.preventDefault();
        openModal();
      }
    });
  })();
</script>
