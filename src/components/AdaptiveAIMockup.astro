---
// Concept-level infographic for the Adaptive AI featured card.
// Just the vision — 3-step adaptive learning flow. Specifics (retrain cadence,
// metrics, anomaly examples) intentionally left out because each deployment
// is customised per shopfloor.
---

<div class="relative mx-auto flex w-full max-w-xl items-center py-4 sm:aspect-[1216/1096] sm:py-0">
  <div class="grid w-full grid-cols-1 items-stretch gap-3 sm:grid-cols-[1fr_auto_1fr_auto_1fr]">
    {/* Step 1 */}
    <div class="rounded-2xl border border-moa-blue/40 bg-gradient-to-br from-moa-blue/15 to-moa-cyan/10 p-5 text-center"
      style="box-shadow: 0 20px 40px -15px rgba(94,106,210,0.4)">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-moa-blue/25 text-moa-cyan">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="12" cy="5" rx="9" ry="3"/>
          <path d="M3 5v6c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>
          <path d="M3 11v6c0 1.66 4.03 3 9 3s9-1.34 9-3v-6"/>
        </svg>
      </div>
      <p class="text-[14px] font-semibold leading-tight text-white">Prediction Engine</p>
      <p class="mt-2 text-[11px] leading-snug text-slate-400">Train AI on real machine data</p>
    </div>

    {/* Arrow — rotates 90° down on mobile (vertical stack), right on desktop */}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5E6AD2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto rotate-90 self-center sm:rotate-0">
      <path d="M5 12h14M13 5l7 7-7 7"/>
    </svg>

    {/* Step 2 */}
    <div class="rounded-2xl border border-moa-blue/40 bg-gradient-to-br from-moa-blue/15 to-moa-cyan/10 p-5 text-center"
      style="box-shadow: 0 20px 40px -15px rgba(94,106,210,0.4)">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-moa-blue/25 text-moa-cyan">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18h6M10 22h4"/>
          <path d="M12 2a7 7 0 0 0-4 12c1 1 2 2 2 4h4c0-2 1-3 2-4a7 7 0 0 0-4-12z"/>
        </svg>
      </div>
      <p class="text-[14px] font-semibold leading-tight text-white">Better Decisions</p>
      <p class="mt-2 text-[11px] leading-snug text-slate-400">Actionable insights and recommendations</p>
    </div>

    {/* Arrow — rotates 90° down on mobile (vertical stack), right on desktop */}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5E6AD2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto rotate-90 self-center sm:rotate-0">
      <path d="M5 12h14M13 5l7 7-7 7"/>
    </svg>

    {/* Step 3 */}
    <div class="rounded-2xl border border-moa-blue/40 bg-gradient-to-br from-moa-blue/15 to-moa-cyan/10 p-5 text-center"
      style="box-shadow: 0 20px 40px -15px rgba(94,106,210,0.4)">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-moa-blue/25 text-moa-cyan">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 4 23 10 17 10"/>
          <polyline points="1 20 1 14 7 14"/>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
        </svg>
      </div>
      <p class="text-[14px] font-semibold leading-tight text-white">Continuous Improve</p>
      <p class="mt-2 text-[11px] leading-snug text-slate-400">Collect latest data, refine model</p>
    </div>
  </div>
</div>
