---
import '@fontsource/kanit/300.css';
import '@fontsource/kanit/400.css';
import '@fontsource/kanit/500.css';
import '@fontsource/kanit/600.css';
import '@fontsource/kanit/700.css';
import '@fontsource/kanit/800.css';
import '../styles/global.css';

import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import CookieBanner from '@components/CookieBanner.astro';
import { getLocaleFromUrl, getDict } from '@i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pathname?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const dict = getDict(locale);

const {
  title = dict.meta.title,
  description = dict.meta.description,
  ogImage = '/og-image.png',
} = Astro.props;

const site = Astro.site ?? 'https://moadigital.co';
const canonical = new URL(Astro.url.pathname, site).toString();

// hreflang pair: EN lives at /x, TH at /th/x (prefixDefaultLocale: false)
const path = Astro.url.pathname;
const thPath = path.startsWith('/th/') || path === '/th' ? path : `/th${path === '/' ? '' : path}` || '/th';
const enPath = path.startsWith('/th') ? path.replace(/^\/th\/?/, '/') : path;
const enUrl = new URL(enPath, site).toString();
const thUrl = new URL(thPath === '' ? '/th' : thPath, site).toString();

// Organization identity for brand search results / knowledge panel.
// ProfessionalService (a LocalBusiness subtype) + postal address ties the
// entity to Bangkok local search and any future Google Business Profile.
const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  name: 'MOA Digital',
  legalName: 'MOA Digital Co., Ltd.',
  url: 'https://moadigital.co/',
  logo: 'https://moadigital.co/apple-touch-icon.png',
  image: 'https://moadigital.co/og-image.png',
  telephone: '+66-61-652-9469',
  email: 'support@moadigital.co',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '33 Borommaratchachonnani 41, Borommaratchachonnani Rd.',
    addressLocality: 'Taling Chan',
    addressRegion: 'Bangkok',
    postalCode: '10170',
    addressCountry: 'TH',
  },
  areaServed: 'TH',
  knowsLanguage: ['th', 'en', 'ja'],
  priceRange: '$$',
  description:
    locale === 'th'
      ? 'MOA Digital บริษัทพัฒนาซอฟต์แวร์ในกรุงเทพฯ รับพัฒนาระบบ SaaS, ระบบงานธุรกิจ (ERP), AI Product และ Smart Factory สำหรับ SME และองค์กร'
      : 'MOA Digital is a Bangkok-based product studio building SaaS platforms, business systems, and AI products for SME and enterprise clients.',
  sameAs: ['https://moa-erp.moadigital.co/', 'https://aidemly.com/'],
});
---

<!doctype html>
<html lang={locale === 'th' ? 'th' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="th" href={thUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <script type="application/ld+json" set:html={orgLd} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://moadigital.co').toString()} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MOA Digital" />
    <meta property="og:locale" content={locale === 'th' ? 'th_TH' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://moadigital.co').toString()} />

    <meta name="theme-color" content="#0F172A" />
  </head>
  <body class="min-h-screen bg-charcoal text-white">
    <div class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[480px] bg-radial-glow"></div>

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <CookieBanner />
  </body>
</html>
