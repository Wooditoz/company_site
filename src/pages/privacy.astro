---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getLocaleFromUrl, getDict } from '@i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const dict = getDict(locale);
const lastUpdated = '26 June 2026';
---

<BaseLayout title="Privacy Policy — MOA Digital" description="How MOA Digital collects, uses, and protects your personal data.">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg" aria-hidden="true"></div>
    <div class="container-x relative pb-6 pt-20 sm:pt-24">
      <div class="max-w-3xl">
        <p class="eyebrow mb-5">Legal</p>
        <h1 class="heading-display text-balance">Privacy Policy</h1>
        <p class="mt-5 text-sm text-muted">Last updated: {lastUpdated}</p>
      </div>
    </div>
  </section>

  <section class="container-x pb-24">
    <div class="prose-legal max-w-3xl space-y-8 text-muted">
      <p>
        MOA Digital Co., Ltd. ("MOA Digital", "we", "our", "us"), registered in Thailand
        under Tax ID 0105569088023, located at 33 Borommaratchachonnani 41, Taling Chan,
        Bangkok 10170, respects your privacy and is committed to protecting your personal
        data. This Privacy Policy describes how we collect, use, and share personal data
        when you visit moadigital.co or contact us.
      </p>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">1. Information We Collect</h2>
        <p class="mb-2">When you submit our contact form, we collect:</p>
        <ul class="ml-5 list-disc space-y-1">
          <li>Name</li>
          <li>Email address</li>
          <li>Company (optional)</li>
          <li>Message content</li>
        </ul>
        <p class="mt-3 mb-2">We also automatically collect:</p>
        <ul class="ml-5 list-disc space-y-1">
          <li>IP address</li>
          <li>Browser type and device information</li>
          <li>Pages visited, time spent, referring URL</li>
          <li>Server logs (kept for 90 days)</li>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">2. How We Use Your Information</h2>
        <ul class="ml-5 list-disc space-y-1">
          <li>Respond to your inquiries and provide requested services</li>
          <li>Communicate about our products and services</li>
          <li>Improve the website and our services</li>
          <li>Detect and prevent abuse, spam, and fraud</li>
          <li>Comply with legal obligations</li>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">3. Legal Basis for Processing</h2>
        <p class="mb-2">We process your personal data based on:</p>
        <ul class="ml-5 list-disc space-y-1">
          <li><strong class="text-white">Your consent</strong> — when you voluntarily submit the contact form</li>
          <li><strong class="text-white">Legitimate business interests</strong> — to operate and improve our services</li>
          <li><strong class="text-white">Legal obligations</strong> — to comply with applicable laws (PDPA, etc.)</li>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">4. Third-Party Service Providers</h2>
        <p class="mb-2">We share information with the following services to operate our website:</p>
        <ul class="ml-5 list-disc space-y-2">
          <li>
            <strong class="text-white">Resend</strong> (email delivery, USA) — processes your email
            address and message to deliver replies. <a href="https://resend.com/legal/privacy-policy" target="_blank" rel="noopener" class="text-moa-cyan hover:underline">Resend Privacy Policy</a>
          </li>
          <li>
            <strong class="text-white">Google reCAPTCHA</strong> — protects the contact form from spam.
            Google may collect technical data per its
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" class="text-moa-cyan hover:underline">Privacy Policy</a>.
          </li>
          <li>
            <strong class="text-white">Google Firebase / Cloud</strong> (hosting) — server logs may
            include IP addresses and request metadata. <a href="https://firebase.google.com/support/privacy" target="_blank" rel="noopener" class="text-moa-cyan hover:underline">Firebase Privacy</a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">5. International Data Transfer</h2>
        <p>
          Some of our service providers (Resend, Google) operate servers outside Thailand,
          including the United States and other regions. We ensure adequate protection
          through standard contractual safeguards and the providers' own compliance
          frameworks (SOC 2, GDPR-aligned terms, etc.).
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">6. Data Retention</h2>
        <ul class="ml-5 list-disc space-y-1">
          <li>Contact form submissions: retained for 2 years from your last contact, unless required longer for legal/contractual reasons</li>
          <li>Server logs: 90 days</li>
          <li>Email correspondence: retained as part of normal business records</li>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">7. Your Rights (PDPA &amp; GDPR)</h2>
        <p class="mb-2">Under Thailand's Personal Data Protection Act (PDPA) Section 30, and GDPR where applicable, you have the right to:</p>
        <ul class="ml-5 list-disc space-y-1">
          <li>Access your personal data we hold</li>
          <li>Correct inaccurate or incomplete data</li>
          <li>Request deletion ("right to be forgotten")</li>
          <li>Restrict or object to processing</li>
          <li>Receive your data in a portable format</li>
          <li>Withdraw consent at any time (without affecting prior lawful processing)</li>
          <li>Lodge a complaint with the Personal Data Protection Committee (PDPC) of Thailand</li>
        </ul>
        <p class="mt-3">
          To exercise any of these rights, email us at
          <a href="mailto:support@moadigital.co" class="text-moa-cyan hover:underline">support@moadigital.co</a>.
          We will respond within 30 days.
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">8. Security</h2>
        <p class="mb-2">We implement reasonable technical and organizational measures to protect your data:</p>
        <ul class="ml-5 list-disc space-y-1">
          <li>HTTPS encryption for all data in transit</li>
          <li>Encrypted storage at rest with our service providers</li>
          <li>Access control with least-privilege principles</li>
          <li>Secret management via Google Cloud Secret Manager</li>
          <li>Regular security reviews and dependency updates</li>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">9. Cookies</h2>
        <p>
          Our website uses cookies for essential functionality, security, and bot
          detection (Google reCAPTCHA). We do not currently use marketing or
          analytics cookies. You can manage your cookie preferences at any time via
          the "Cookie Settings" link in the footer.
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">10. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. Material changes will
          be posted on this page with an updated "Last updated" date. Continued use of
          the website constitutes acceptance of the updated policy.
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">11. Contact Us</h2>
        <p class="mb-2">For privacy-related questions or to exercise your rights, contact:</p>
        <div class="rounded-lg border border-hairline bg-surface/60 p-5 text-sm text-white/90">
          <p class="font-semibold">MOA Digital Co., Ltd.</p>
          <p>33 Borommaratchachonnani 41, Taling Chan, Bangkok 10170, Thailand</p>
          <p>Tax ID: 0105569088023</p>
          <p class="mt-2">
            Email: <a href="mailto:support@moadigital.co" class="text-moa-cyan hover:underline">support@moadigital.co</a>
          </p>
          <p>Phone: (+66) 61-652-9469</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
