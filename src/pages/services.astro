---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServicesGrid from '@components/ServicesGrid.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { getLocaleFromUrl, getDict } from '@i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const dict = getDict(locale);

// Each offering as a Service entity so "software development company
// Bangkok"-class queries can match us at the service level, not just the org.
const servicesLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: dict.services.items.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.description,
      provider: { '@type': 'Organization', name: 'MOA Digital' },
      areaServed: 'TH',
    },
  })),
});
---

<BaseLayout title={`${dict.nav.services} — MOA Digital`} description={dict.services.subtitle}>
  <script type="application/ld+json" set:html={servicesLd} />
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg" aria-hidden="true"></div>
    <div class="container-x relative pb-6 pt-20 sm:pt-24">
      <div class="max-w-3xl">
        <p class="eyebrow mb-5">{dict.services.eyebrow}</p>
        <h1 class="heading-display text-balance">{dict.services.title}</h1>
        {dict.services.subtitle && (
          <p class="mt-5 text-body text-balance">{dict.services.subtitle}</p>
        )}
      </div>
    </div>
  </section>
  <ServicesGrid showHeader={false} />
  <ContactCTA />
</BaseLayout>
