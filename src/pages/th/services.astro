---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServicesGrid from '@components/ServicesGrid.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { getLocaleFromUrl, getDict } from '@i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const dict = getDict(locale);
---

<BaseLayout title={`${dict.nav.services} — MOA Digital`} description={dict.services.subtitle}>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg" aria-hidden="true"></div>
    <div class="container-x relative pb-6 pt-20 sm:pt-24">
      <div class="max-w-3xl">
        <p class="eyebrow mb-5">{dict.services.eyebrow}</p>
        <h1 class="heading-display text-balance">{dict.services.title}</h1>
        {dict.services.subtitle && (
          <p class="mt-5 text-body text-balance">{dict.services.subtitle}</p>
        )}
      </div>
    </div>
  </section>
  <ServicesGrid showHeader={false} />
  <ContactCTA />
</BaseLayout>
