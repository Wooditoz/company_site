---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getLocaleFromUrl, getDict } from '@i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const dict = getDict(locale);
const lastUpdated = '26 มิถุนายน 2026';
---

<BaseLayout title="ข้อกำหนดการใช้บริการ — MOA Digital" description="ข้อกำหนดการใช้งานเว็บไซต์ MOA Digital">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg" aria-hidden="true"></div>
    <div class="container-x relative pb-6 pt-20 sm:pt-24">
      <div class="max-w-3xl">
        <p class="eyebrow mb-5">ข้อกฎหมาย</p>
        <h1 class="heading-display text-balance">ข้อกำหนดการใช้บริการ</h1>
        <p class="mt-5 text-sm text-muted">ปรับปรุงล่าสุด: {lastUpdated}</p>
      </div>
    </div>
  </section>

  <section class="container-x pb-24">
    <div class="prose-legal max-w-3xl space-y-8 text-muted">
      <p>
        ข้อกำหนดการใช้บริการนี้ ("ข้อกำหนด") ครอบคลุมการเข้าถึงและการใช้งานเว็บไซต์
        moadigital.co ("เว็บไซต์") ดำเนินงานโดยบริษัท เอ็มโอเอ ดิจิทัล จำกัด
        (เลขประจำตัวผู้เสียภาษี 0105569088023 ตั้งอยู่ที่ 33 ซอยบรมราชชนนี 41
        แขวงตลิ่งชัน เขตตลิ่งชัน กรุงเทพมหานคร 10170)
        การเข้าใช้เว็บไซต์ถือว่าคุณยอมรับข้อกำหนดเหล่านี้
      </p>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">1. การใช้งานที่อนุญาต</h2>
        <p class="mb-2">คุณใช้เว็บไซต์ได้เพื่อวัตถุประสงค์ที่ถูกต้องตามกฎหมายเท่านั้น โดยตกลงไม่:</p>
        <ul class="ml-5 list-disc space-y-1">
          <li>ใช้เว็บไซต์ในทางที่อาจสร้างความเสียหายหรือทำให้ไม่สามารถใช้งานได้</li>
          <li>พยายามเข้าถึงพื้นที่ ระบบ หรือบัญชีที่ไม่เปิดสาธารณะ</li>
          <li>ใช้ระบบอัตโนมัติ (bots, scrapers, crawlers) โดยไม่ได้รับอนุญาต</li>
          <li>หลบเลี่ยงมาตรการความปลอดภัยหรือ rate-limit</li>
          <li>ส่งข้อมูลเท็จ ทำให้เข้าใจผิด หรือผิดกฎหมายผ่านฟอร์มติดต่อ</li>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">2. ทรัพย์สินทางปัญญา</h2>
        <p>
          เนื้อหาทั้งหมดในเว็บไซต์ — รวมถึงข้อความ ภาพ ภาพประกอบ โค้ด ดีไซน์ โลโก้ และเครื่องหมายการค้า —
          เป็นกรรมสิทธิ์ของบริษัท เอ็มโอเอ ดิจิทัล จำกัด หรือมีลิขสิทธิ์อยู่ภายใต้เรา
          ห้ามคัดลอก ทำซ้ำ เผยแพร่ ดัดแปลง หรือสร้างงานต่อยอด โดยไม่ได้รับอนุญาตเป็นลายลักษณ์อักษร
          ชื่อ MOA Digital และโลโก้เป็นเครื่องหมายการค้าของบริษัท เอ็มโอเอ ดิจิทัล จำกัด
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">3. ฟอร์มติดต่อและการสื่อสาร</h2>
        <p>
          เมื่อคุณส่งฟอร์มติดต่อ ข้อมูลที่ให้จะถูกประมวลผลตาม
          <a href="/th/privacy" class="text-moa-cyan hover:underline">นโยบายความเป็นส่วนตัว</a>
          เราจะตอบกลับภายใน 1-2 วันทำการ แต่ไม่รับประกันเวลาตอบกลับที่แน่นอน
          การส่งฟอร์มไม่ถือเป็นข้อตกลงทางกฎหมายเรื่องบริการ ใดๆ การให้บริการต้องมีสัญญาเป็นลายลักษณ์อักษรแยก
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">4. ข้อมูลผลิตภัณฑ์และบริการ</h2>
        <p>
          ข้อมูลเกี่ยวกับผลิตภัณฑ์ของเรา (เช่น Aidemly, Stock Management System, Adaptive AI)
          จัดทำเพื่อการอ้างอิง ข้อกำหนด คุณสมบัติ ราคา และความพร้อมใช้งานอาจเปลี่ยนแปลงได้โดยไม่แจ้งล่วงหน้า
          การส่งมอบบริการจริงดำเนินตามสัญญาเป็นลายลักษณ์อักษร statement of work
          หรือสัญญาบริการหลักที่แยกออกไป
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">5. ข้อปฏิเสธความรับผิด</h2>
        <p>
          เว็บไซต์ให้บริการในลักษณะ "ตามที่เป็น" และ "ตามที่มี" โดยไม่มีการรับประกันใดๆ
          ทั้งโดยตรงและโดยปริยาย เท่าที่กฎหมายอนุญาต MOA Digital ปฏิเสธการรับประกันทั้งหมด
          รวมถึงการรับประกันเรื่องการขายได้ ความเหมาะสมกับวัตถุประสงค์เฉพาะ และการไม่ละเมิดสิทธิ์
          เราไม่รับประกันว่าเว็บไซต์จะใช้งานได้ตลอด ปราศจากข้อผิดพลาด ปลอดภัย หรือไม่มี harmful components
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">6. ข้อจำกัดความรับผิด</h2>
        <p>
          เท่าที่กฎหมายอนุญาต MOA Digital กรรมการ พนักงาน และพาร์ทเนอร์ ไม่รับผิดต่อ
          ความเสียหายโดยอ้อม โดยบังเอิญ พิเศษ หรือเป็นผลสืบเนื่อง รวมถึงการสูญเสียกำไร ข้อมูล
          โอกาสทางธุรกิจ หรือ goodwill ที่เกิดจากการใช้งานหรือไม่สามารถใช้งานเว็บไซต์
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">7. การชดใช้ค่าเสียหาย</h2>
        <p>
          คุณตกลงชดใช้และไม่เรียกร้องค่าเสียหายจาก MOA Digital เจ้าหน้าที่ กรรมการ พนักงาน และตัวแทน
          สำหรับการเรียกร้อง ความเสียหาย ความสูญเสีย หรือค่าใช้จ่าย (รวมค่าทนายความตามสมควร)
          ที่เกิดจากการใช้งานเว็บไซต์ในทางมิชอบหรือการละเมิดข้อกำหนดเหล่านี้
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">8. ลิงก์ภายนอก</h2>
        <p>
          เว็บไซต์อาจมีลิงก์ไปยังเว็บไซต์หรือบริการของบุคคลที่สาม เราไม่รับผิดชอบเนื้อหา ความถูกต้อง
          แนวปฏิบัติด้านความเป็นส่วนตัว หรือเงื่อนไขของบุคคลเหล่านั้น การเข้าใช้เป็นความเสี่ยงของคุณเอง
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">9. กฎหมายที่ใช้บังคับ</h2>
        <p>
          ข้อกำหนดเหล่านี้อยู่ภายใต้กฎหมายของราชอาณาจักรไทย โดยไม่คำนึงถึงหลักการขัดกันของกฎหมาย
          ข้อพิพาทใดที่เกิดจากข้อกำหนดเหล่านี้หรือการใช้เว็บไซต์ ให้ระงับโดยศาลที่มีเขตอำนาจในกรุงเทพมหานคร
          ประเทศไทย เท่านั้น
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">10. การเปลี่ยนแปลงข้อกำหนด</h2>
        <p>
          เราสามารถปรับปรุงข้อกำหนดได้ตลอดเวลาโดยเผยแพร่เวอร์ชันใหม่ในหน้านี้ วันที่ "ปรับปรุงล่าสุด"
          จะแสดงการแก้ไขล่าสุด การใช้งานต่อไปหลังการเปลี่ยนแปลงถือว่ายอมรับข้อกำหนดที่อัพเดต
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">11. การแยกข้อกำหนด</h2>
        <p>
          หากข้อกำหนดใดข้อหนึ่งถูกพบว่าใช้บังคับไม่ได้ ข้อกำหนดส่วนที่เหลือยังคงมีผลใช้บังคับเต็มที่
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-white">12. ติดต่อ</h2>
        <p class="mb-2">สำหรับคำถามเกี่ยวกับข้อกำหนดเหล่านี้:</p>
        <div class="rounded-lg border border-hairline bg-surface/60 p-5 text-sm text-white/90">
          <p class="font-semibold">บริษัท เอ็มโอเอ ดิจิทัล จำกัด</p>
          <p>เลขที่ 33 ซอยบรมราชชนนี 41 ถนนบรมราชชนนี แขวงตลิ่งชัน เขตตลิ่งชัน กรุงเทพมหานคร 10170</p>
          <p>เลขประจำตัวผู้เสียภาษี: 0105569088023</p>
          <p class="mt-2">
            อีเมล: <a href="mailto:support@moadigital.co" class="text-moa-cyan hover:underline">support@moadigital.co</a>
          </p>
          <p>โทร: (+66) 61-652-9469</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
